# Copiar como .env y completar. No subir .env al repositorio.

# ─── Base de datos (PostgreSQL en Render) ───────────────────────────────
# En local se usa la External URL. Al desplegar en Render, definir allá
# DATABASE_URL con la Internal URL (tiene prioridad sobre estas dos).
DATABASE_URL_EXTERNAL=postgresql://usuario:contraseña@host.ohio-postgres.render.com:5432/base
DATABASE_URL_INTERNAL=postgresql://usuario:contraseña@host:5432/base

# ─── Autenticación ───────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión en segundos (7 días).
JWT_TTL_SECONDS=604800

# ─── Servidor ────────────────────────────────────────────────────────────
PORT=3000
# Orígenes permitidos por CORS, separados por coma. Vacío = cualquiera.
CORS_ORIGIN=http://localhost:5173
# Cargar los libros de ejemplo que falten al arrancar (true/false).
SEED=true
