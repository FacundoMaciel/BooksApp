# Copiar como .env y completar. No subir .env al repositorio.

# PostgreSQL. En local se usa la External URL de Render; al desplegar en Render, DATABASE_URL = Internal URL.
DATABASE_URL_EXTERNAL=postgresql://usuario:contraseña@host.render.com:5432/base
